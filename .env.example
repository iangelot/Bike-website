# RAGERIDE — environment variables.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Settings → API). `.env.local` is git-ignored and never committed.
#
# With none of these set, the site still runs — it falls back to the built-in
# seed inventory. Set them to switch the site (and the admin panel) onto the
# live database.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SERVER ONLY. Never prefix with NEXT_PUBLIC and never put
# it in the browser. Used only by the one-off seed script.
SUPABASE_SERVICE_ROLE_KEY=
